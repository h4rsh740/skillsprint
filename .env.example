# ─────────────────────────────────────────────────────────────
# SkillSprint AI — Environment Variables Template
# Copy to .env.local and fill in your values.
# Never commit .env.local to git.
# ─────────────────────────────────────────────────────────────

# ── Firebase (Authentication) ─────────────────────────────────
# Get these from: Firebase Console → Project Settings → General → Your Apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Supabase / Database (Prisma ORM) ─────────────────────────
# Get these from: Supabase Dashboard → Connect → ORM tab
# Use Transaction Pooler URL (port 6543) for DATABASE_URL — NOT direct port 5432
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Generative AI ─────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ── GitHub OAuth (for GitHub profile analysis) ───────────────
# Get from: GitHub → Settings → Developer Settings → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

# ── SMTP (Email / Password Reset) ────────────────────────────
# Use any SMTP provider (Gmail, Resend, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── App Config ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional Integrations ────────────────────────────────────
# Job search APIs (used in /dashboard/jobs)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=

# OpenRouter (fallback AI model gateway — optional)
OPENROUTER_API_KEY=
